extends Node
## Sound manager: pooled one-shot players, named looping channels and music.
## All sounds are generated by tools/gen_audio.py (original, no third-party samples).

const DIR := "res://assets/audio/"
const LOOPS := ["brush_small", "brush_large", "scrubber_loop", "rotary_loop", "vacuum_loop",
	"industrial_vacuum_loop", "beam_loop", "engine_loop", "machine_loop", "drone_loop",
	"ambient_base", "music_ambient"]

var _streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _loops := {}       # channel -> AudioStreamPlayer
var _music: AudioStreamPlayer


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_buses()
	for i in 10:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	Settings.apply()


func _setup_buses() -> void:
	for name in ["Music", "SFX"]:
		if AudioServer.get_bus_index(name) == -1:
			var idx := AudioServer.bus_count
			AudioServer.add_bus(idx)
			AudioServer.set_bus_name(idx, name)
			AudioServer.set_bus_send(idx, "Master")


func stream(name: String) -> AudioStream:
	if _streams.has(name):
		return _streams[name]
	var path := DIR + name + ".wav"
	if not ResourceLoader.exists(path):
		_streams[name] = null
		return null
	var s: AudioStreamWAV = load(path)
	# Loops are set up by the importer (edit/loop_mode in the .import files). Setting
	# loop_end by hand to the last frame left the Cleaning Beam's sound stuck on its
	# final frame on some phones, and the game crashed soon after.
	if s and LOOPS.has(name) and s.loop_mode == AudioStreamWAV.LOOP_DISABLED:
		s = s.duplicate()
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = maxi(int(s.get_length() * s.mix_rate) - 64, 1)
	_streams[name] = s
	return s


func play(name: String, volume_db := 0.0, pitch := 1.0) -> void:
	var s := stream(name)
	if s == null:
		return
	for p in _pool:
		if not p.playing:
			p.stream = s
			p.volume_db = volume_db
			p.pitch_scale = pitch
			p.play()
			return
	# All busy: steal the first one.
	_pool[0].stream = s
	_pool[0].volume_db = volume_db
	_pool[0].pitch_scale = pitch
	_pool[0].play()


## Start/update/stop a named looping sound channel.
func loop(channel: String, name: String, on: bool, volume_db := 0.0, pitch := 1.0) -> void:
	var p: AudioStreamPlayer = _loops.get(channel)
	if not on:
		if p and p.playing:
			p.stop()
		return
	if p == null:
		p = AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_loops[channel] = p
	var s := stream(name)
	if p.stream != s:
		p.stream = s
		p.stop()
	p.volume_db = volume_db
	p.pitch_scale = pitch
	if not p.playing and s:
		p.play()


func stop_all_loops() -> void:
	for c in _loops:
		_loops[c].stop()


## Plays a one-off music track on the music channel (replacing the ambient loop).
func play_track(name: String, volume_db := 0.0) -> void:
	_music.stream = stream(name)
	_music.volume_db = volume_db
	_music.play()


func play_music(on: bool) -> void:
	if on:
		if not _music.playing:
			_music.stream = stream("music_ambient")
			_music.volume_db = -4.0
			_music.play()
	else:
		_music.stop()
