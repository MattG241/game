; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-1837596758312011~9171190618"

[application]

config/name="Lunar Cleanup"
config/description="Clean the Moon with a toothbrush. Build a lunar cleaning empire."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="LunarCleanup"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.016, 0.02, 0.043, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/textures/splash.png"
config/icon="res://icon.png"

[autoload]

Diagnostics="*res://scripts/autoload/diagnostics.gd"
Settings="*res://scripts/autoload/settings.gd"
GameData="*res://scripts/autoload/game_data.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Audio="*res://scripts/autoload/audio.gd"
IAP="*res://scripts/autoload/iap.gd"
Ads="*res://scripts/autoload/ads.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=6

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/admob/plugin.cfg")

[gui]

common/drag_threshold=12

[physics]

common/max_physics_steps_per_frame=4
3d/default_gravity=3.2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/positional_shadow/atlas_size=1024
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
